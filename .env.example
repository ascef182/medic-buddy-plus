# BuddyDoctor — variáveis de ambiente (template)
# Copie para `.env` e preencha com as credenciais do seu projeto Supabase
# (Settings → API no dashboard do Supabase). NUNCA commite o `.env` real.

VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-aqui"

# CAPTCHA (Cloudflare Turnstile) no login/cadastro/reset de senha.
# Crie uma site key gratuita em https://dash.cloudflare.com/?to=/:account/turnstile
# e configure a secret key correspondente no Supabase Dashboard em
# Authentication → Providers → Email → Enable CAPTCHA protection.
# Para desenvolvimento local, a chave de teste abaixo sempre passa e não
# exige conta no Cloudflare (nunca use em produção):
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
